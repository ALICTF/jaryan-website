---
import ReservationModal from './ReservationModal.jsx';
---

<section class="relative min-h-[100vh] flex items-center justify-center overflow-hidden bg-paper pt-20">
    
    <div class="absolute inset-0 z-10 pointer-events-none opacity-[0.03]" 
         style="background-image: radial-gradient(circle, #000000 1px, transparent 1px); background-size: 30px 30px;">
    </div>

    <div class="absolute inset-0 z-0">
        <img 
            src="https://hadihashemi.info/wp-content/uploads/2025/12/IMG_20251212_095439_481-scaled.jpg" 
            class="w-full h-full object-cover opacity-25 scale-105 animate-breathe" 
            alt="Hero Background"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-paper via-paper/40 to-paper/80"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-paper via-transparent to-paper"></div>
    </div>

    <div class="absolute top-0 left-1/4 w-96 h-96 bg-turquoise/10 rounded-full blur-[120px] animate-pulse-slow mix-blend-multiply"></div>
    <div class="absolute bottom-0 right-1/4 w-[500px] h-[500px] bg-gold/10 rounded-full blur-[150px] animate-pulse-slower mix-blend-multiply"></div>

    <div class="relative z-20 text-center px-6 max-w-5xl mx-auto">
        
        <div class="mb-8 opacity-0 animate-fade-in-up" style="animation-delay: 0.2s;">
            <div class="inline-flex items-center gap-3 py-1.5 px-5 border border-ink/10 rounded-full bg-white/60 backdrop-blur-md shadow-sm">
                <span class="w-1.5 h-1.5 rounded-full bg-turquoise animate-pulse"></span>
                <span class="text-ink text-xs md:text-sm tracking-widest font-bold uppercase">گروه ادبی جریان</span>
                <span class="w-1.5 h-1.5 rounded-full bg-turquoise animate-pulse"></span>
            </div>
        </div>

        <h1 class="text-5xl md:text-7xl lg:text-9xl font-black text-ink mb-8 leading-tight tracking-tight opacity-0 animate-fade-in-up" style="animation-delay: 0.4s;">
            جایی برای
            <br class="hidden md:block" />
            <span class="relative inline-block mx-2 md:mx-4 mt-4 pb-2">
                <span class="absolute inset-0 bg-white/50 blur-2xl rounded-full transform scale-110"></span>
                
                <span class="relative text-transparent bg-clip-text bg-gradient-to-r from-[#0ea5e9] via-[#1e3a8a] to-[#0ea5e9] animate-text-shimmer bg-[length:200%_auto] drop-shadow-sm">
                    جـریـان
                </span>
                
                <svg class="absolute w-[110%] h-4 -bottom-1 -left-[5%] text-tala opacity-100" viewBox="0 0 100 10" preserveAspectRatio="none">
                    <path d="M0 5 Q 50 12 100 5" stroke="currentColor" stroke-width="2.5" fill="none" class="animate-draw-line" />
                </svg>
            </span>
            یافتن کلمات
        </h1>

        <p class="text-lg md:text-2xl text-ink/90 mb-12 leading-loose max-w-3xl mx-auto font-light opacity-0 animate-fade-in-up font-['Vazirmatn']" style="animation-delay: 0.7s;">
            ما در <span class="text-ink font-bold border-b-2 border-gold/50">"جریان"</span> گرد هم می‌آییم تا صدای کلمات را بشنویم.
            <br />
            بررسی آثار ادبی جهان، در فضایی که عطر کاغذ و تاریخ می‌دهد.
        </p>

        <div class="flex flex-col md:flex-row gap-6 justify-center items-center opacity-0 animate-fade-in-up" style="animation-delay: 1s;">
            <div class="relative group">
                <div class="absolute -inset-0.5 bg-gradient-to-r from-lajevard to-turquoise rounded-full blur opacity-30 group-hover:opacity-60 transition duration-500"></div>
                <ReservationModal client:load />
            </div>
            
            <a href="#archive" class="group flex items-center gap-3 text-ink hover:text-lajevard transition-colors duration-300 px-4 py-2 font-bold">
                <span class="text-lg border-b-2 border-transparent group-hover:border-lajevard pb-0.5 transition-all">مشاهده آرشیو آثار</span>
                <span class="w-8 h-8 rounded-full border-2 border-ink/10 flex items-center justify-center group-hover:bg-lajevard group-hover:text-white group-hover:border-lajevard transition-all duration-300 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 transform group-hover:rotate-45 transition-transform">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                </span>
            </a>
        </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 opacity-0 animate-fade-in-up" style="animation-delay: 1.5s;">
        <div class="w-6 h-10 border-2 border-ink/30 rounded-full flex justify-center p-1 cursor-pointer hover:border-ink transition-colors">
            <div class="w-1.5 h-1.5 bg-ink rounded-full animate-scroll-down"></div>
        </div>
    </div>
</section>

<style>
    @keyframes breathe {
        0% { transform: scale(1.05); }
        100% { transform: scale(1.15); }
    }
    .animate-breathe {
        animation: breathe 15s ease-in-out infinite alternate;
    }

    @keyframes textShimmer {
        0% { background-position: 200% center; }
        100% { background-position: -200% center; }
    }
    .animate-text-shimmer {
        animation: textShimmer 4s linear infinite;
    }

    @keyframes pulseSlow {
        0%, 100% { opacity: 0.3; transform: scale(1); }
        50% { opacity: 0.6; transform: scale(1.1); }
    }
    .animate-pulse-slow { animation: pulseSlow 8s ease-in-out infinite; }
    .animate-pulse-slower { animation: pulseSlow 12s ease-in-out infinite reverse; }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
            filter: blur(5px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
            filter: blur(0);
        }
    }
    .animate-fade-in-up {
        animation: fadeInUp 1s cubic-bezier(0.2, 1, 0.3, 1) forwards;
    }

    @keyframes scrollDown {
        0% { transform: translateY(0); opacity: 1; }
        100% { transform: translateY(15px); opacity: 0; }
    }
    .animate-scroll-down {
        animation: scrollDown 2s infinite;
    }
    
    @keyframes drawLine {
        0% { stroke-dasharray: 0 100; opacity: 0; }
        100% { stroke-dasharray: 100 100; opacity: 1; }
    }
    .animate-draw-line {
        stroke-dasharray: 100;
        animation: drawLine 1.5s ease-out forwards;
        animation-delay: 0.5s;
    }
</style>