---
import ReservationModal from './ReservationModal.jsx';
import ArtisticCountdown from './ArtisticCountdown.jsx';

// تاریخ ۵ روز آینده
const targetDate = new Date();
targetDate.setDate(targetDate.getDate() + 5); 
const targetDateString = targetDate.toISOString();
---

<section class="relative min-h-[100vh] flex items-center justify-center overflow-hidden bg-paper pt-20 perspective-1000">
    
    <div class="absolute inset-0 z-10 pointer-events-none opacity-[0.04] mix-blend-multiply" 
         style="background-image: url('https://www.transparenttextures.com/patterns/stardust.png');">
    </div>

    <div class="absolute inset-0 z-0">
        <img 
            src="https://hadihashemi.info/wp-content/uploads/2025/12/IMG_20251212_095439_481-scaled.jpg" 
            class="w-full h-full object-cover opacity-30 scale-110 animate-breathe mix-blend-multiply" 
            alt="Hero Background"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-paper via-paper/40 to-paper/90"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-paper via-transparent to-paper"></div>
    </div>

    <div class="absolute top-0 left-0 w-[600px] h-[600px] bg-turquoise/20 rounded-full blur-[100px] animate-morph mix-blend-multiply"></div>
    <div class="absolute bottom-0 right-0 w-[700px] h-[700px] bg-gold/15 rounded-full blur-[120px] animate-morph animation-delay-2000 mix-blend-multiply"></div>
    
    <div class="absolute inset-0 z-10 pointer-events-none overflow-hidden">
        <div class="absolute top-1/4 left-1/4 w-2 h-2 bg-gold/40 rounded-full blur-[1px] animate-float-particle"></div>
        <div class="absolute top-1/3 right-1/3 w-1.5 h-1.5 bg-turquoise/40 rounded-full blur-[1px] animate-float-particle animation-delay-1000"></div>
        <div class="absolute bottom-1/4 left-1/2 w-3 h-3 bg-lajevard/20 rounded-full blur-[2px] animate-float-particle animation-delay-3000"></div>
    </div>

    <div class="relative z-20 text-center  max-w-5xl mx-auto">
        
        <div class="mb-8 opacity-0 animate-fade-in-up" style="animation-delay: 0.2s;">
            <div class="inline-flex items-center gap-3 py-2 px-6 border border-ink/5 rounded-full bg-white/40 backdrop-blur-md shadow-lg ring-1 ring-white/50 hover:scale-105 transition-transform duration-500 cursor-default">
                <span class="w-2 h-2 rounded-full bg-turquoise animate-pulse shadow-[0_0_10px_rgba(14,165,233,0.5)]"></span>
                <span class="text-ink text-xs md:text-sm tracking-[0.2em] font-bold uppercase">گروه ادبی جریان</span>
                <span class="w-2 h-2 rounded-full bg-turquoise animate-pulse shadow-[0_0_10px_rgba(14,165,233,0.5)]"></span>
            </div>
        </div>

        <h1 class="text-5xl md:text-7xl lg:text-9xl font-black text-ink mb-8 leading-tight tracking-tight opacity-0 animate-fade-in-up drop-shadow-sm" style="animation-delay: 0.4s;">
            جایی برای
            <br class="hidden md:block" />
            <span class="relative inline-block  mb-3 ">
                <span class="absolute inset-0 bg-gradient-to-r from-turquoise/0 via-turquoise/10 to-turquoise/0 blur-xl animate-pulse-slow"></span>
                
                <span class="relative z-10 text-transparent bg-clip-text bg-gradient-to-br from-firoozeh via-lajevard to-firoozeh animate-text-shimmer bg-[length:200%_auto]">
                    جـریـان
                </span>
                
                <svg class="absolute w-[120%] h-6 -bottom-3 -left-[10%] text-tala opacity-0 animate-draw-line" viewBox="0 0 120 10" preserveAspectRatio="none" style="animation-delay: 1s; animation-fill-mode: forwards;">
                    <path d="M0 5 Q 60 15 120 5" stroke="currentColor" stroke-width="3" stroke-linecap="round" fill="none" />
                </svg>
            </span>
            یافتن کلمات
        </h1>

        <p class="text-lg md:text-2xl text-ink/80 mb-12 leading-relaxed max-w-3xl mx-auto font-light opacity-0 animate-fade-in-up font-['Vazirmatn'] relative" style="animation-delay: 0.7s;">
            <span class="absolute -top-6 -left-4 text-6xl text-gold/20 font-serif opacity-50">“</span>
            ما در <span class="text-ink font-bold relative inline-block">
                "جریان"
                <span class="absolute bottom-1 left-0 w-full h-2 bg-gold/20 -z-10 rounded-sm skew-x-[-10deg]"></span>
            </span> 
            گرد هم می‌آییم تا صدای کلمات را بشنویم.
            <br />
            بررسی آثار ادبی جهان، در فضایی که عطر کاغذ و تاریخ می‌دهد.
        </p>

        <div class="mb-3 relative z-30">
            <p class="text-xs text-ink/50 mb-1 font-bold tracking-[0.2em] uppercase opacity-0 animate-fade-in-up" 
               style="animation-delay: 1s; animation-fill-mode: forwards;">
                زمان باقی‌مانده تا نشست بعدی
            </p>
            <ArtisticCountdown client:only="react" targetDate={targetDateString} />
        </div>

        <div class="flex flex-col md:flex-row gap-8 justify-center items-center opacity-0 animate-fade-in-up" style="animation-delay: 1.6s;">
            <div class="relative group">
                <div class="absolute -inset-1 bg-gradient-to-r from-lajevard via-turquoise to-lajevard rounded-full blur opacity-25 group-hover:opacity-75 transition duration-1000 group-hover:duration-200 animate-gradient-xy"></div>
                <div class="relative transform transition duration-500 group-hover:-translate-y-1">
                    <ReservationModal client:load />
                </div>
            </div>
            
        </div>
    </div>


</section>

<style>
  /* --- انیمیشن‌های پس‌زمینه و افکت‌ها --- */
  @keyframes morph {
    0%, 100% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; transform: translate(0, 0); }
    50% { border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%; transform: translate(20px, -20px); }
  }
  .animate-morph { animation: morph 15s ease-in-out infinite; }

  @keyframes floatParticle {
    0%, 100% { transform: translate(0, 0); opacity: 0.5; }
    50% { transform: translate(20px, -20px); opacity: 1; }
  }
  .animate-float-particle { animation: floatParticle 8s ease-in-out infinite; }

  @keyframes breathe {
    0% { transform: scale(1.05); }
    100% { transform: scale(1.15); }
  }
  .animate-breathe { animation: breathe 20s ease-in-out infinite alternate; }

  @keyframes textShimmer {
    0% { background-position: 200% center; }
    100% { background-position: -200% center; }
  }
  .animate-text-shimmer { animation: textShimmer 5s linear infinite; }

  @keyframes gradientXY {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  .animate-gradient-xy { background-size: 200% 200%; animation: gradientXY 3s ease infinite; }

  /* --- انیمیشن‌های ورود (یک بار اجرا شوند) --- */
  @keyframes fadeInUp {
    0% { opacity: 0; transform: translateY(40px); filter: blur(8px); }
    100% { opacity: 1; transform: translateY(0); filter: blur(0); }
  }
  /* تعریف گلوبال و یک‌بار برای جلوگیری از پرش */
  :global(.animate-fade-in-up) {
    animation: fadeInUp 1.2s cubic-bezier(0.2, 1, 0.3, 1) forwards;
    animation-fill-mode: forwards;
  }

  @keyframes drawLine {
    0% { stroke-dasharray: 0 120; opacity: 0; }
    100% { stroke-dasharray: 120 120; opacity: 1; }
  }
  .animate-draw-line { stroke-dasharray: 120; animation: drawLine 2s ease-out forwards; }

  @keyframes scrollDown {
    0% { transform: translateY(0); opacity: 1; }
    50% { transform: translateY(10px); opacity: 0; }
    51% { transform: translateY(-10px); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }
  .animate-scroll-down { animation: scrollDown 2s cubic-bezier(0.4, 0, 0.2, 1) infinite; }

  /* انیمیشن خطوط تایمر */
  @keyframes expandWidth {
    from { width: 0; opacity: 0; }
    to { width: 60px; opacity: 1; }
  }
  :global(.animate-expand-width) {
    animation: expandWidth 1.5s cubic-bezier(0.2, 1, 0.3, 1) forwards;
  }

  /* کلاس‌های کمکی تاخیر */
  .animation-delay-1000 { animation-delay: 1s; }
  .animation-delay-2000 { animation-delay: 2s; }
  .animation-delay-3000 { animation-delay: 3s; }
</style>