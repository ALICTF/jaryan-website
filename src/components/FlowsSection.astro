---
/* Flows.astro */
import FlowsSlider from './FlowsSlider.jsx';

// ایمپورت CSS های Swiper
import 'swiper/css';
import 'swiper/css/effect-cards';
import 'swiper/css/pagination';

interface Flow {
  country: string;
  flag: string;
  style: string;
  books: string[];
}

interface Props {
  flows: Flow[];
}

const { flows } = Astro.props;
---

<section id="flows" class="relative overflow-hidden bg-lajevard py-24 min-h-[700px] flex flex-col justify-center">
    
    <div class="absolute inset-0 opacity-10 pointer-events-none mix-blend-screen bg-[url('https://www.transparenttextures.com/patterns/arabesque.png')]"></div>
    
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-firoozeh/20 rounded-full blur-[120px] pointer-events-none"></div>

    <div class="container mx-auto px-6 relative z-10">
        
        <div class="text-center mb-16">
            <div class="inline-flex items-center justify-center gap-3 mb-4 opacity-80">
                <div class="h-px w-8 bg-gradient-to-l from-tala to-transparent"></div>
                <span class="text-tala text-xs font-bold tracking-[0.2em] uppercase">گنجینه ملل</span>
                <div class="h-px w-8 bg-gradient-to-r from-tala to-transparent"></div>
            </div>
            
            <h3 class="text-4xl lg:text-5xl font-black text-white mb-6 drop-shadow-md">
                روایت‌های <span class="text-firoozeh">جهان</span>
            </h3>
            
            <p class="text-white/70 font-light text-lg max-w-lg mx-auto leading-8">
                گزیده‌ای از آثار ماندگار ادبیات جهان، در قابی از نقش و نگار ایرانی.
            </p>
        </div>

        <FlowsSlider client:load flows={flows} />

    </div>
</section>

<style is:global>
    /* استایل دکمه‌های صفحه‌بندی (Pagination) */
    .swiper-pagination-bullet {
        background-color: #ffffff;
        opacity: 0.4;
    }
    .swiper-pagination-bullet-active {
        background-color: #fbbf24 !important; /* Tala Color */
        width: 20px;
        border-radius: 10px;
        opacity: 1;
        transition: width 0.3s ease;
    }
</style>