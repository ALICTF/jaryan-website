---
/* Flows.astro */
import FlowsSlider from './FlowsSlider.jsx';

// ایمپورت CSS های لازم
import 'swiper/css';
import 'swiper/css/effect-creative';
import 'swiper/css/pagination';

interface Flow {
  country: string;
  flag: string;
  style: string;
  books: string[];
}

interface Props {
  flows: Flow[];
}

const { flows } = Astro.props;
---

<section id="flows" class="relative overflow-hidden bg-[#F3F4F6] min-h-[700px] flex flex-col justify-center py-20">
    
    <div class="absolute inset-0 opacity-[0.4]" 
         style="background-image: radial-gradient(#cbd5e1 1.5px, transparent 1.5px); background-size: 24px 24px;">
    </div>
    
    <div class="absolute inset-0 bg-gradient-to-t from-[#F3F4F6] via-transparent to-[#F3F4F6]"></div>

    <div class="container mx-auto px-6 relative z-10">
        
        <div class="flex flex-col md:flex-row items-center justify-between mb-16 gap-6 max-w-4xl mx-auto">
            <div class="text-center md:text-right">
                <h3 class="text-4xl lg:text-5xl font-black text-ink mb-2">کلکسیون ملل</h3>
                <p class="text-slate-500 text-sm font-medium">نگاهی کوتاه به گنجینه‌های ادبی جهان</p>
            </div>
            
            <div class="hidden md:flex items-center gap-2">
                <div class="h-px w-16 bg-slate-300"></div>
                <div class="text-xs font-mono text-slate-400">SCROLL TO EXPLORE</div>
            </div>
        </div>

        <div class="max-w-5xl mx-auto">
            <FlowsSlider client:load flows={flows} />
        </div>

    </div>
</section>

<style is:global>
    /* کاستومایز کردن دکمه‌های Pagination */
    .swiper-pagination-bullet {
        background: #94a3b8;
        opacity: 0.5;
        transition: all 0.3s;
    }
    .swiper-pagination-bullet-active {
        background: #0f172a !important;
        width: 24px;
        border-radius: 10px;
        opacity: 1;
    }
</style>