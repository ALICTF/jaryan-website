---
interface SpecialFlow {
  title: string;
  desc: string;
  icon: string;
  image: string;
}

interface Props {
  flows: SpecialFlow[];
}

const { flows } = Astro.props;
---

<section class="py-24 bg-kashi relative">
    <div class="container mx-auto px-6">
        <h3 class="text-3xl font-black text-center text-lajevard mb-16">پنجره‌هایی رو به جریان</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {flows.map((flow) => (
                <div class="relative h-96 group cursor-pointer perspective-1000">
                    <div class="absolute inset-0 rounded-t-full border-4 border-ajor bg-white overflow-hidden shadow-2xl transition-transform duration-500 group-hover:-translate-y-2">
                        <img src={flow.image} class="w-full h-full object-cover opacity-90 group-hover:scale-110 transition duration-700" alt={flow.title} />
                        <div class="absolute inset-0 bg-lajevard/40 mix-blend-multiply group-hover:bg-transparent transition duration-500"></div>
                        
                        <div class="absolute bottom-0 left-0 w-full p-6 bg-gradient-to-t from-black/90 to-transparent text-center">
                            <div class="w-12 h-12 mx-auto bg-firoozeh rounded-full flex items-center justify-center text-2xl mb-2 shadow-lg text-white">
                                {flow.icon}
                            </div>
                            <h4 class="text-xl font-bold text-white mb-1">{flow.title}</h4>
                            <p class="text-xs text-white/80">{flow.desc}</p>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>