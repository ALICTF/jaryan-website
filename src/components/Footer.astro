---
/* Footer.astro - نسخه نهایی: منوی کلیکی (Clickable) */
const currentYear = new Date().getFullYear().toLocaleString('fa-IR').replace(/,/g, '');
---

<footer class="relative bg-[#0B1221] pt-32 pb-10 overflow-hidden text-white/80">

    <div class="absolute top-0 left-0 w-full overflow-hidden leading-none z-20">
        <svg class="relative block w-[calc(100%+1.3px)] h-[60px] text-[#F3F4F6]" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
            <path d="M0,0V46.29c47.79,22.2,103.59,32.17,158,28,70.36-5.37,136.33-33.31,206.8-37.5C438.64,32.43,512.34,53.67,583,72.05c69.27,18,138.3,24.88,209.4,13.08,36.15-6,69.85-17.84,104.45-29.34C989.49,25,1113-14.29,1200,52.47V0Z" opacity=".25" fill="currentColor"></path>
            <path d="M0,0V15.81C13,36.92,27.64,56.86,47.69,72.05,99.41,111.27,165,111,224.58,91.58c31.15-10.15,60.09-26.07,89.67-39.8,40.92-19,84.73-46,130.83-49.67,36.26-2.85,70.9,9.42,98.6,31.56,31.77,25.39,62.32,62,103.63,73,40.44,10.79,81.35-6.69,119.13-24.28s75.16-39,116.92-43.05c59.73-5.85,113.28,22.88,168.9,38.84,30.2,8.66,59,6.17,87.09-7.5,22.43-10.89,48-26.93,60.65-49.24V0Z" opacity=".5" fill="currentColor"></path>
            <path d="M0,0V5.63C149.93,59,314.09,71.32,475.83,42.57c43-7.64,84.23-20.12,127.61-26.46,59-8.63,112.48,12.24,165.56,35.4C827.93,77.22,886,95.24,951.2,90c86.53-7,172.46-45.71,248.8-84.81V0Z" fill="currentColor"></path>
        </svg>
    </div>

    <div class="absolute top-20 right-0 opacity-[0.03] pointer-events-none select-none">
        <svg width="600" height="400" viewBox="0 0 200 200">
             <text x="50%" y="50%" font-family="Nastaliq, serif" font-size="150" fill="white" text-anchor="middle" dominant-baseline="middle">جریان</text>
        </svg>
    </div>
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/arabesque.png')] opacity-5 pointer-events-none"></div>

    <div class="container mx-auto px-6 relative z-10">
        
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12 mb-16 border-b border-white/10 pb-16">
            
            <div class="md:col-span-5 flex flex-col items-center md:items-start text-center md:text-right space-y-6">
                <div class="relative w-20 h-20 group cursor-default">
                    <div class="absolute inset-0 bg-gradient-to-tr from-lajevard to-firoozeh rounded-2xl rotate-45 blur opacity-60"></div>
                    <div class="relative w-full h-full bg-[#0B1221] border border-tala/30 rounded-2xl rotate-45 flex items-center justify-center overflow-hidden shadow-2xl transition-colors duration-500">
                        <span class="text-3xl font-black text-white -rotate-45 relative z-10">جـ</span>
                        <div class="absolute inset-0 bg-eslimi opacity-20 -rotate-45 scale-150"></div>
                    </div>
                </div>
                <div>
                    <h4 class="text-3xl font-black text-white mb-4 tracking-tight">گروه ادبی <span class="text-firoozeh">جریان</span></h4>
                    <p class="text-sm leading-8 text-slate-400 max-w-sm">
                        رودی از آگاهی برای خواندن، نوشتن و زیستن در دنیای کلمات.
                    </p>
                </div>
            </div>

            <div class="md:col-span-3 flex flex-col items-center md:items-start">
                <h5 class="text-tala font-bold text-lg mb-6 relative inline-block">دسترسی سریع</h5>
                <ul class="space-y-4 text-sm text-slate-300 w-full text-center md:text-right">
                    <li><a href="#about" class="hover:text-firoozeh hover:pr-2 transition-all duration-300 flex items-center justify-center md:justify-start gap-2 group"><span class="w-1.5 h-1.5 bg-firoozeh rounded-full opacity-0 group-hover:opacity-100 transition-opacity"></span>درباره ما</a></li>
                    <li><a href="#founders" class="hover:text-firoozeh hover:pr-2 transition-all duration-300 flex items-center justify-center md:justify-start gap-2 group"><span class="w-1.5 h-1.5 bg-firoozeh rounded-full opacity-0 group-hover:opacity-100 transition-opacity"></span>اهالی عمارت</a></li>
                    <li><a href="#flows" class="hover:text-firoozeh hover:pr-2 transition-all duration-300 flex items-center justify-center md:justify-start gap-2 group"><span class="w-1.5 h-1.5 bg-firoozeh rounded-full opacity-0 group-hover:opacity-100 transition-opacity"></span>گنجینه ملل</a></li>
                </ul>
            </div>

            <div class="md:col-span-4 flex flex-col items-center md:items-start">
                <h5 class="text-tala font-bold text-lg mb-6 relative inline-block">همراه با جریان</h5>
                <div class="w-full bg-white/5 border border-white/10 rounded-xl p-6 backdrop-blur-sm mb-6 relative overflow-hidden group">
                    <div class="absolute -right-6 -top-6 w-20 h-20 bg-firoozeh/20 rounded-full blur-xl group-hover:bg-firoozeh/30 transition-colors"></div>
                    <p class="text-xs text-slate-400 mb-4">برای دریافت آخرین رویدادها و نشست‌ها عضو شوید.</p>
                    <div class="flex gap-2">
                        <input type="email" placeholder="ایمیل شما..." class="bg-black/30 border border-white/10 rounded-lg px-4 py-2 text-sm w-full focus:outline-none focus:border-firoozeh/50 transition-colors text-white placeholder-white/30" />
                        <button class="bg-firoozeh hover:bg-firoozeh/80 text-[#0B1221] p-2 rounded-lg transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 rotate-180" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex flex-col md:flex-row justify-between items-center text-xs text-slate-500 font-medium pt-4">
            <p>تمامی حقوق محفوظ است © {currentYear} | گروه ادبی جریان</p>
            
            <div class="flex items-center gap-6 mt-6 md:mt-0">
                
                <div class="relative z-50" id="dev-container">
                    
                    <button id="dev-trigger" class="flex items-center gap-3 cursor-pointer py-2 px-4 rounded-full border border-white/5 bg-white/5 hover:bg-white/10 hover:border-tala/30 transition-all duration-300 focus:outline-none focus:ring-1 focus:ring-tala/50">
                        <div class="w-6 h-6 rounded-full bg-lajevard border border-tala flex items-center justify-center overflow-hidden shrink-0">
                            <span class="text-[9px] font-black text-tala">MK</span>
                        </div>
                        <div class="flex flex-col items-start">
                            <span class="text-[8px] text-firoozeh uppercase tracking-wider leading-none mb-0.5">Designed & Dev By</span>
                            <span class="text-[10px] font-bold text-white transition-colors">Mostafa Khajenejad</span>
                        </div>
                        <svg id="dev-arrow" class="w-3 h-3 text-slate-500 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                    </button>

                    <div id="dev-menu" class="absolute bottom-full left-1/2 -translate-x-1/2 mb-3 w-48 bg-[#0F172A] border border-tala/30 rounded-xl shadow-[0_10px_40px_-10px_rgba(251,191,36,0.3)] overflow-hidden transition-all duration-300 transform origin-bottom opacity-0 invisible translate-y-4 scale-95">
                        <div class="bg-lajevard/50 p-2 text-center border-b border-white/5">
                            <span class="text-[10px] text-tala font-bold">Contact Me</span>
                        </div>
                        <div class="p-2 flex justify-around items-center">
                            
                            <a href="https://github.com/ALICTF" target="_blank" class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white/10 text-slate-400 hover:text-white transition-all" aria-label="Github">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                            </a>

                            <a href="https://t.me/moskha" target="_blank" class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-blue-500/20 text-slate-400 hover:text-blue-400 transition-all" aria-label="Telegram">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
                            </a>

                            <a href="tel:09157152958" class="w-8 h-8 flex items-center justify-center rounded-lg hover:bg-green-500/20 text-slate-400 hover:text-green-400 transition-all" aria-label="Phone">
                                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                            </a>
                        </div>
                        <div class="absolute bottom-[-5px] left-1/2 -translate-x-1/2 w-3 h-3 bg-[#0F172A] border-b border-r border-tala/30 rotate-45"></div>
                    </div>
                </div>

            </div>
        </div>

    </div>
</footer>

<script>
    // 1. Console Signature
    console.log(
        "%c Developed by Mostafa Khajenejad ",
        "background-color: #0F172A; color: #FBBF24; padding: 10px 20px; border-radius: 4px; font-family: sans-serif; font-weight: bold; font-size: 14px; border: 1px solid #FBBF24; margin-top: 10px;"
    );
    console.groupCollapsed("%c Contact Info 📡", "color: #38bdf8; font-family: sans-serif;");
        console.log("%c GitHub:    %c https://github.com/ALICTF", "color: #94a3b8; font-weight: bold;", "color: #38bdf8;");
        console.log("%c Telegram:  %c @moskha", "color: #94a3b8; font-weight: bold;", "color: #38bdf8;");
        console.log("%c Phone:     %c 09157152958", "color: #94a3b8; font-weight: bold;", "color: #38bdf8;");
    console.groupEnd();

    const devTrigger = document.getElementById('dev-trigger');
    const devMenu = document.getElementById('dev-menu');
    const devArrow = document.getElementById('dev-arrow');
    const devContainer = document.getElementById('dev-container');
    let isOpen = false;

    if(devTrigger && devMenu && devArrow) {
        devTrigger.addEventListener('click', (e) => {
            e.stopPropagation();
            isOpen = !isOpen;
            toggleMenu();
        });

        // Close when clicking outside
        document.addEventListener('click', (e) => {
            if (isOpen && devContainer && !devContainer.contains(e.target)) {
                isOpen = false;
                toggleMenu();
            }
        });

        function toggleMenu() {
            if (isOpen) {
                // Open State
                devMenu.classList.remove('opacity-0', 'invisible', 'translate-y-4', 'scale-95');
                devMenu.classList.add('opacity-100', 'visible', 'translate-y-0', 'scale-100');
                devArrow.classList.add('rotate-180');
                devTrigger.classList.add('border-tala/50', 'bg-white/10');
            } else {
                // Closed State
                devMenu.classList.add('opacity-0', 'invisible', 'translate-y-4', 'scale-95');
                devMenu.classList.remove('opacity-100', 'visible', 'translate-y-0', 'scale-100');
                devArrow.classList.remove('rotate-180');
                devTrigger.classList.remove('border-tala/50', 'bg-white/10');
            }
        }
    }
</script>