---
/* SectionDivider.astro - طرح تذهیب و تاریخ */
---

<div class="relative flex justify-center items-center py-24 overflow-hidden">
    
    <div class="absolute inset-0 flex justify-center items-center opacity-[0.03] pointer-events-none select-none overflow-hidden">
        <span class="text-9xl font-['Nastaliq'] text-ink whitespace-nowrap blur-sm transform -rotate-6">
            چو ایران نباشد تن من مباد
        </span>
    </div>

    <div class="relative h-[2px] w-1/3 max-w-[300px] bg-gradient-to-l from-tala via-ink/20 to-transparent">
        <div class="absolute right-0 -top-1.5 w-3 h-3 bg-tala rounded-full rotate-45 opacity-50"></div>
        <div class="absolute right-0 top-1/2 -translate-y-1/2 w-full h-[1px] bg-gradient-to-r from-transparent via-lajevard to-transparent animate-ink-pulse"></div>
    </div>

    <div class="relative mx-6 w-24 h-24 flex items-center justify-center group">
        
        <div class="absolute inset-0 bg-gradient-to-tr from-tala/20 to-transparent rounded-full blur-xl animate-pulse-slow"></div>

        <div class="absolute inset-0 w-full h-full flex items-center justify-center animate-spin-super-slow">
            <svg viewBox="0 0 100 100" class="w-full h-full text-lajevard drop-shadow-lg opacity-90">
                <path d="M50 0 L63 25 L90 20 L75 43 L95 60 L70 70 L65 95 L45 75 L20 85 L30 60 L5 50 L30 35 Z" 
                      fill="none" stroke="currentColor" stroke-width="1.5" />
                <path d="M50 10 L60 30 L80 25 L68 45 L85 60 L65 68 L60 90 L45 72 L25 80 L35 60 L15 50 L35 38 Z" 
                      fill="currentColor" opacity="0.1" />
            </svg>
        </div>

        <div class="absolute inset-4 border-2 border-tala/40 rounded-full rotate-45"></div>

        <div class="relative z-10 w-10 h-10 text-ink drop-shadow-md transform transition-transform duration-500 group-hover:scale-110">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path class="animate-book-flutter origin-center" d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                <path class="animate-book-flutter-reverse origin-center" d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
            </svg>
        </div>
    </div>

    <div class="relative h-[2px] w-1/3 max-w-[300px] bg-gradient-to-r from-tala via-ink/20 to-transparent">
        <div class="absolute left-0 -top-1.5 w-3 h-3 bg-tala rounded-full rotate-45 opacity-50"></div>
        <div class="absolute left-0 top-1/2 -translate-y-1/2 w-full h-[1px] bg-gradient-to-l from-transparent via-lajevard to-transparent animate-ink-pulse animation-delay-1000"></div>
    </div>

</div>

<style>
    /* چرخش بسیار آرام شمسه */
    @keyframes spinSuperSlow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .animate-spin-super-slow {
        animation: spinSuperSlow 60s linear infinite;
    }

    /* تپش جوهر در خطوط */
    @keyframes inkPulse {
        0%, 100% { opacity: 0.3; width: 80%; }
        50% { opacity: 1; width: 100%; }
    }
    .animate-ink-pulse {
        animation: inkPulse 4s ease-in-out infinite;
    }

    /* حرکت ورق کتاب */
    @keyframes bookFlutter {
        0%, 100% { d: path("M4 19.5A2.5 2.5 0 0 1 6.5 17H20"); }
        50% { d: path("M4 19.5A2.5 2.5 0 0 1 6.5 15H20"); } /* کمی بالا رفتن صفحه */
    }
    /* انیمیشن SVG Path نیاز به پشتیبانی دارد، جایگزین ساده‌تر: */
    @keyframes flutterSimple {
        0%, 100% { transform: scaleX(1); }
        50% { transform: scaleX(0.9); }
    }
    .animate-book-flutter {
        animation: flutterSimple 3s ease-in-out infinite;
    }

    /* هاله نور */
    @keyframes pulseSlow {
        0%, 100% { opacity: 0.3; transform: scale(1); }
        50% { opacity: 0.6; transform: scale(1.1); }
    }
    .animate-pulse-slow {
        animation: pulseSlow 5s ease-in-out infinite;
    }
    
    .animation-delay-1000 { animation-delay: 1s; }
</style>