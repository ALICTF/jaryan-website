---
/* SectionDivider.astro - طرح نهایی با کادر بالا و پایین */
---

<div class="relative w-full flex justify-center items-center py-6 overflow-hidden bg-transparent">
    
    <div class="absolute top-0 left-0 w-full h-[3px] bg-gradient-to-r from-lajevard via-firoozeh to-lajevard shadow-[0_2px_15px_rgba(14,165,233,0.4)]">
        <div class="absolute inset-0 bg-white/40 w-full h-full animate-shimmer-bar"></div>
    </div>

    <div class="flex flex-col gap-1.5 w-full max-w-sm items-end opacity-90">
        <div class="h-[1px] w-full bg-gradient-to-l from-transparent via-lajevard to-turquoise/50"></div>
        <div class="h-[1px] w-4/5 bg-gradient-to-l from-transparent via-lajevard/60 to-turquoise/30"></div>
    </div>

    <div class="relative mx-5 flex-shrink-0">
        <div class="absolute inset-0 bg-turquoise/20 blur-lg rounded-full animate-pulse-slow"></div>
        
        <div class="relative w-10 h-10 border border-lajevard bg-paper shadow-[0_0_15px_rgba(14,165,233,0.3)] flex items-center justify-center animate-spin-slow">
            <div class="w-5 h-5 bg-lajevard/10 border border-tala rotate-45 transform"></div>
            <div class="absolute w-1.5 h-1.5 bg-tala rounded-full shadow-sm"></div>
        </div>
    </div>

    <div class="flex flex-col gap-1.5 w-full max-w-sm items-start opacity-90">
        <div class="h-[1px] w-full bg-gradient-to-r from-transparent via-lajevard to-turquoise/50"></div>
        <div class="h-[1px] w-4/5 bg-gradient-to-r from-transparent via-lajevard/60 to-turquoise/30"></div>
    </div>

    <div class="absolute bottom-0 left-0 w-full h-[3px] bg-gradient-to-r from-lajevard via-firoozeh to-lajevard shadow-[0_-2px_15px_rgba(14,165,233,0.4)]">
        <div class="absolute inset-0 bg-white/40 w-full h-full animate-shimmer-bar"></div>
    </div>

</div>

<style>
    /* چرخش ۳۶۰ درجه آرام و دائمی */
    @keyframes spinSlow {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .animate-spin-slow {
        animation: spinSlow 15s linear infinite;
    }

    /* حرکت نور روی نوارهای بالا و پایین */
    @keyframes shimmerBar {
        0% { transform: translateX(-100%); opacity: 0; }
        50% { opacity: 1; }
        100% { transform: translateX(100%); opacity: 0; }
    }
    .animate-shimmer-bar {
        animation: shimmerBar 3s linear infinite;
    }

    /* تپش هاله */
    @keyframes pulseSlow {
        0%, 100% { opacity: 0.4; transform: scale(1); }
        50% { opacity: 0.8; transform: scale(1.1); }
    }
    .animate-pulse-slow {
        animation: pulseSlow 3s ease-in-out infinite;
    }
</style>