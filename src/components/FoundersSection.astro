---
interface Founder {
  name: string;
  role: string;
  image: string;
}

interface Props {
  founders: Founder[];
}

const { founders } = Astro.props;
---

<section id="founders" class="py-24 bg-gradient-to-b from-white to-kashi">
    <div class="container mx-auto px-6 text-center">
        <h3 class="text-3xl font-black text-lajevard mb-16">اهالی این عمارت</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
            {founders.map((person) => (
                <div class="group relative">
                    <div class="bg-white pt-12 pb-8 px-6 rounded-t-[50%] rounded-b-lg border border-slate-100 shadow-xl hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 relative overflow-hidden">
                        <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-lajevard via-firoozeh to-lajevard"></div>
                        
                        <div class="w-32 h-32 mx-auto mb-6 rounded-full p-1 border-2 border-tala group-hover:bg-tala transition-colors duration-500">
                            <img src={person.image} alt={person.name} class="w-full h-full rounded-full object-cover filter grayscale group-hover:grayscale-0 transition duration-500" />
                        </div>
                        <h4 class="text-xl font-bold text-lajevard mb-2">{person.name}</h4>
                        <span class="text-sm text-ajor font-medium">{person.role}</span>
                        
                        <div class="mt-6 flex justify-center opacity-30 group-hover:opacity-100 transition duration-500">
                            <svg class="w-6 h-6 text-lajevard" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L14.5 9.5H22L16 14.5L18.5 22L12 17.5L5.5 22L8 14.5L2 9.5H9.5L12 2Z"/></svg>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>